{
  "hooks": {
    "SessionStart": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/link-statusline.cjs\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/usage-quota-cache-refresh.cjs\"" } ] }
    ],
    "UserPromptSubmit": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/usage-quota-cache-refresh.cjs\"" } ] }
    ],
    "Stop": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/usage-quota-cache-refresh.cjs\"" },
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/monthly-cost-refresh.cjs\"" }
      ] }
    ]
  }
}
